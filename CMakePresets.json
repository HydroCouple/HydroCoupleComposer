{
    "version": 3,
    "configurePresets": [
        {
            "name": "default-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "Darwin",
            "inherits": "default",
            "description": "macOS Release build (Ninja). Qt located via the QT_ROOT_DIR env var; override with -DCMAKE_PREFIX_PATH. HydroCouple/HydroCoupleSDK expected at ../HydroCouple*/install/Darwin.",
            "binaryDir": "${sourceDir}/build/darwin",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "-O2 -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O2 -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "Darwin-debug",
            "inherits": "default-debug",
            "description": "macOS Debug build (Ninja).",
            "binaryDir": "${sourceDir}/build/darwin-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math",
                "CMAKE_CXX_FLAGS": "-O0 -g -DDEBUG -Wall -Wextra -fno-fast-math",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "Linux",
            "inherits": "default",
            "description": "Linux Release build (Ninja).",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "-O2 -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra -fvisibility=hidden",
                "CMAKE_CXX_FLAGS": "-O2 -fdata-sections -ffunction-sections -fno-fast-math -Wall -Wextra",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Linux-debug",
            "inherits": "default-debug",
            "description": "Linux Debug build (Ninja).",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Windows",
            "inherits": "default",
            "description": "Windows Release build (MSVC, Ninja — requires the MSVC dev environment on PATH).",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /O2 /fp:precise /W4",
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /GR /O2 /fp:precise /W4",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Windows-debug",
            "inherits": "default-debug",
            "description": "Windows Debug build (MSVC, Ninja).",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /GR /Zi /Od /DDEBUG /W4 /fp:precise",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "Darwin", "configurePreset": "Darwin" },
        { "name": "Linux", "configurePreset": "Linux" },
        { "name": "Windows", "configurePreset": "Windows" }
    ],
    "testPresets": [
        {
            "name": "Darwin",
            "configurePreset": "Darwin",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "Linux",
            "configurePreset": "Linux",
            "output": { "outputOnFailure": true }
        }
    ]
}
